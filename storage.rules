rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }

    // /users/{uid}/cards/{cardId}/(cardImage|receipts/{entryId})
    match /users/{uid}/cards/{cardId}/{allPaths=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidImage();
    }

    // Club logos uploaded from /admin/clubs (ADR #61). System catalog assets,
    // not anyone's data: readable by any signed-in user, writable by no client
    // at all — not even an admin's browser. The upload goes through
    // setClubLogoAction, which checks adminRoles server-side and writes with
    // the Admin SDK, so this stays `if false` for the same reason clubs/ and
    // clubCards/ do in firestore.rules.
    //
    // The app itself renders these through a download-token URL, which serves
    // the object without consulting these rules at all; the read allowance is
    // for anything that goes through the client SDK.
    match /clubLogos/{clubId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
