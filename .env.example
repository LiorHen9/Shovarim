# Copy to .env.local and fill in real values (never commit .env.local).
# Client-side Firebase config (safe to expose in the browser bundle):
# Firebase Console -> Project settings -> General -> Your apps -> Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to point the client SDK at local Firebase Emulators.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Server-side only. Set to "true" when running against `firebase emulators:start`
# so the Admin SDK auto-connects without real credentials.
FIREBASE_USE_EMULATOR=false
# When FIREBASE_USE_EMULATOR=true, also set these so firebase-admin (which
# reads them directly) routes to the local emulators instead of production:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Server-side only secrets — a Firebase service account.
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# Never expose these with a NEXT_PUBLIC_ prefix.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Server-side only. AES-256 key (base64, 32 bytes) for application-level
# encryption of cvv/barcodeOrCode (src/lib/crypto/fieldEncryption.ts) — a
# defense-in-depth layer beyond Firestore's at-rest encryption, see
# docs/SECURITY.md. Generate one per environment (never reuse DEV/PROD keys):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production this is a Secret Manager reference in apphosting.yaml (see
# Set-AppHosting-CardEncryptionKey.ps1), never a plaintext value.
CARD_FIELD_ENCRYPTION_KEY=

# Client-side. Firebase App Check site key — a reCAPTCHA *Enterprise* key id
# (docs/DECISIONS.md ADR #28), created in Google Cloud Console -> Security ->
# reCAPTCHA and then registered under Firebase Console -> App Check -> Apps ->
# reCAPTCHA Enterprise provider. Not a secret (safe to expose in the browser
# bundle, like the other NEXT_PUBLIC_* vars above): it identifies the site to
# reCAPTCHA, it doesn't authenticate anything by itself. See docs/SECURITY.md.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Set to "true" only for local dev/CI against emulators — registers a debug
# token with the App Check emulator/console instead of running reCAPTCHA.
# Never set this in production.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG=false

# Server-side only. DEV credential: Anthropic Console -> Workspace (dev) ->
# API Keys -> Create key. Used by the MCP CLI (scripts/mcp-cli.ts) and, once
# built, the in-app chatbot's dev environment. Leave the 4 vars below empty
# in DEV/local .env.local - src/lib/mcp/anthropicClient.ts falls back to this
# key whenever ANTHROPIC_FEDERATION_RULE_ID is unset.
ANTHROPIC_API_KEY=

# Server-side only. PROD credential (set these, and leave ANTHROPIC_API_KEY
# unset, in apphosting.yaml/production) - Workload Identity Federation
# against the Claude API itself, not Firebase and not Vertex AI. The GCP
# service account attached to the Firebase App Hosting backend mints its own
# Google-signed identity token from the Cloud Run metadata server, which
# Anthropic exchanges for a short-lived access token. See docs/DECISIONS.md
# ADR #20 for the one-time Claude Console setup (Settings -> Workload
# identity -> Connect workload -> Google Cloud) that produces these IDs.
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_WORKSPACE_ID=

# Server-side only, OPTIONAL. Monthly spend target in USD that the admin home
# page (/admin) shows the month-to-date Claude cost against as a progress bar.
# A display target, not an enforced cap - nothing is throttled when it is
# exceeded (the rate limits in src/lib/mcp/config.ts are the actual control).
# Read lazily in src/lib/services/adminClaudeUsage.ts, so `next build` never
# needs it; leave it unset (or non-numeric) and the bar simply is not rendered.
CLAUDE_MONTHLY_BUDGET_USD=

# Server-side only. WhatsApp Cloud API (docs/ROADMAP.md Phase 5.5,
# docs/DEPLOYMENT.md). All four are read lazily inside the webhook handler, so
# `next build` never needs them; in production the three secrets are Secret
# Manager references in apphosting.yaml with `availability: [RUNTIME]` only.
# The webhook answers 503 (rather than crashing) while APP_SECRET/VERIFY_TOKEN
# are empty, which is the state between Phase 5.5.b and 5.5.c.
#
# Meta App Dashboard -> App settings -> Basic -> App Secret. Signs every
# inbound delivery (X-Hub-Signature-256) and is the webhook's ONLY trust
# boundary — the sender's phone number proves nothing on its own.
WHATSAPP_APP_SECRET=
# A random string we choose; Meta echoes it back during the GET handshake when
# the webhook URL is registered. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WHATSAPP_VERIFY_TOKEN=
# Permanent access token for sending replies through the Graph API.
WHATSAPP_ACCESS_TOKEN=
# Not secret: the business number's id (WhatsApp -> API Setup). Also used to
# ignore deliveries meant for another number under the same Meta app.
WHATSAPP_PHONE_NUMBER_ID=
# Optional override of the Graph API base URL, e.g. to pin a different version
# or to point tests at a local stub. Defaults to https://graph.facebook.com/v23.0
WHATSAPP_GRAPH_BASE_URL=

# Client-side. Not a secret — the bot's public WhatsApp number, in E.164
# (digits only or with "+", either works, see src/lib/whatsapp/deepLink.ts).
# Used to build the wa.me deep link in /settings (issue #39): different value
# from WHATSAPP_PHONE_NUMBER_ID above, which is the Graph API's private
# identifier for the same number, not the number itself.
NEXT_PUBLIC_WHATSAPP_BOT_PHONE=

# Client-side. Not a secret — the app's own absolute base URL, no trailing
# slash. Needed only by the list-invite flow (ADR #37, issue #58): the invite
# link is pasted into a WhatsApp message, where a relative path is meaningless.
# Locally this is http://localhost:3000; in production it is the App Hosting
# URL (set in apphosting.yaml). Falls back to localhost:3000 when unset, so a
# forgotten value shows up as a broken invite link rather than a build error.
NEXT_PUBLIC_APP_URL=
