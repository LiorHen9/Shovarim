# Copy to .env.local and fill in real values (never commit .env.local).
# Client-side Firebase config (safe to expose in the browser bundle):
# Firebase Console -> Project settings -> General -> Your apps -> Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to point the client SDK at local Firebase Emulators.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Server-side only. Set to "true" when running against `firebase emulators:start`
# so the Admin SDK auto-connects without real credentials.
FIREBASE_USE_EMULATOR=false
# When FIREBASE_USE_EMULATOR=true, also set these so firebase-admin (which
# reads them directly) routes to the local emulators instead of production:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Server-side only secrets — a Firebase service account.
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# Never expose these with a NEXT_PUBLIC_ prefix.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Server-side only. AES-256 key (base64, 32 bytes) for application-level
# encryption of cvv/barcodeOrCode (src/lib/crypto/fieldEncryption.ts) — a
# defense-in-depth layer beyond Firestore's at-rest encryption, see
# docs/SECURITY.md. Generate one per environment (never reuse DEV/PROD keys):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production this is a Secret Manager reference in apphosting.yaml (see
# Set-AppHosting-CardEncryptionKey.ps1), never a plaintext value.
CARD_FIELD_ENCRYPTION_KEY=

# Client-side. Firebase App Check site key (reCAPTCHA v3) — Firebase Console
# -> App Check -> Apps -> register the web app -> reCAPTCHA v3 provider. Not a
# secret (safe to expose in the browser bundle, like the other NEXT_PUBLIC_*
# vars above): it identifies the site to reCAPTCHA, it doesn't authenticate
# anything by itself. See docs/SECURITY.md.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Set to "true" only for local dev/CI against emulators — registers a debug
# token with the App Check emulator/console instead of running reCAPTCHA.
# Never set this in production.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG=false

# Server-side only. DEV credential: Anthropic Console -> Workspace (dev) ->
# API Keys -> Create key. Used by the MCP CLI (scripts/mcp-cli.ts) and, once
# built, the in-app chatbot's dev environment. Leave the 4 vars below empty
# in DEV/local .env.local - src/lib/mcp/anthropicClient.ts falls back to this
# key whenever ANTHROPIC_FEDERATION_RULE_ID is unset.
ANTHROPIC_API_KEY=

# Server-side only. PROD credential (set these, and leave ANTHROPIC_API_KEY
# unset, in apphosting.yaml/production) - Workload Identity Federation
# against the Claude API itself, not Firebase and not Vertex AI. The GCP
# service account attached to the Firebase App Hosting backend mints its own
# Google-signed identity token from the Cloud Run metadata server, which
# Anthropic exchanges for a short-lived access token. See docs/DECISIONS.md
# ADR #20 for the one-time Claude Console setup (Settings -> Workload
# identity -> Connect workload -> Google Cloud) that produces these IDs.
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_WORKSPACE_ID=
