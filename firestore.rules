rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isNewOwner() {
      return isOwner(request.resource.data.ownerId);
    }

    function isExistingOwner() {
      return isOwner(resource.data.ownerId);
    }

    // --- List sharing (docs/DECISIONS.md #15) ---
    // A member doc lives at cardLists/{listId}/members/{memberUid}, doc id ==
    // memberUid. Helpers below read it via get()/exists(); every caller must
    // short-circuit through isSignedIn()/exists() first so a missing doc never
    // reaches `.data` (that throws, which Firestore treats as deny — safe, but
    // wasteful to trigger on every check).
    function memberDoc(listId) {
      return get(/databases/$(database)/documents/cardLists/$(listId)/members/$(request.auth.uid));
    }

    function memberDocExists(listId) {
      return exists(/databases/$(database)/documents/cardLists/$(listId)/members/$(request.auth.uid));
    }

    function isAcceptedListMember(listId) {
      return isSignedIn() && memberDocExists(listId) && memberDoc(listId).data.status == 'accepted';
    }

    function isManagerOfList(listId) {
      return isAcceptedListMember(listId) && memberDoc(listId).data.role == 'manager';
    }

    function isPendingInvitee(listId) {
      return isSignedIn() && memberDocExists(listId) && memberDoc(listId).data.status == 'pending';
    }

    function listOwnerId(listId) {
      return get(/databases/$(database)/documents/cardLists/$(listId)).data.ownerId;
    }

    // --- Admin (docs/DECISIONS.md ADR #42) ---
    // adminRoles/{uid} is the source of truth for admin status — not a
    // custom claim, so exists() below answers immediately with no
    // token-refresh propagation delay. Same get()/exists() pattern as
    // isAcceptedListMember above, just at top level instead of a
    // list-scoped subcollection.
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid));
    }

    // Deny everything by default; every collection below is an explicit exception.
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read, update: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow delete: if false; // deletion goes through the account-deletion Cloud Function only
    }

    match /consents/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.data.uid == uid;
      allow delete: if false;
    }

    match /cardLists/{listId} {
      allow read: if isExistingOwner() || isAcceptedListMember(listId) || isPendingInvitee(listId);
      allow create: if isNewOwner();
      allow update: if isExistingOwner() && isNewOwner()
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isExistingOwner();

      match /members/{memberUid} {
        function isListOwnerCaller() {
          return isSignedIn() && listOwnerId(listId) == request.auth.uid;
        }

        function isSelf() {
          return isSignedIn() && request.auth.uid == memberUid;
        }

        allow read: if isListOwnerCaller() || isSelf();

        // Owner invites a member — must target this doc's uid explicitly, with
        // a valid role, always starting out pending.
        //
        // No client calls this any more: ADR #38 removed the email invite path
        // that wrote pending member docs, and the invite flow that replaced it
        // (now ADR #39) writes straight to "accepted" from the Admin SDK, which
        // bypasses Rules entirely. Kept rather than tightened to `if false`
        // because the pending docs it created still exist and are still accepted
        // through the `update` branch below — narrowing this now would only make
        // the two halves disagree about a shape the data still has.
        allow create: if isListOwnerCaller()
          && request.resource.data.memberUid == memberUid
          && request.resource.data.listId == listId
          && request.resource.data.role in ['manager', 'viewer']
          && request.resource.data.status == 'pending';

        // Owner may change an existing member's role (status left untouched);
        // the invitee may flip their own doc from pending -> accepted only.
        allow update: if request.resource.data.memberUid == resource.data.memberUid
          && request.resource.data.listId == resource.data.listId
          && (
            (isListOwnerCaller()
              && request.resource.data.role in ['manager', 'viewer']
              && request.resource.data.status == resource.data.status)
            || (isSelf()
              && resource.data.status == 'pending'
              && request.resource.data.status == 'accepted'
              && request.resource.data.role == resource.data.role)
          );

        // Owner removes a member, or a member removes themselves (decline/leave).
        allow delete: if isListOwnerCaller() || isSelf();
      }
    }

    // A rule scoped to a fixed ancestor (like the nested `members` match above)
    // does not extend to collectionGroup queries — those need a `{path=**}`
    // rule of their own. Used by useCardLists/usePendingInvitations, which both
    // query collectionGroup(db, "members") filtered by memberUid == the caller,
    // matching the condition below so Firestore can prove the query is safe.
    match /{path=**}/members/{memberUid} {
      allow read: if isSignedIn() && resource.data.memberUid == request.auth.uid;
    }

    match /cards/{cardId} {
      // `list` requests (useCards.ts queries `where("listId", "in", listIds)`)
      // only guarantee resource.data for fields the query itself filters on —
      // reading resource.data.ownerId here throws "Property ownerId is
      // undefined" for a list request. Route ownership through listId
      // (which the query does filter on) via listOwnerId() instead.
      allow read: if isOwner(listOwnerId(resource.data.listId)) || isAcceptedListMember(resource.data.listId);

      allow create: if request.resource.data.listId is string
        && request.resource.data.listId.size() > 0
        && request.resource.data.ownerId == listOwnerId(request.resource.data.listId)
        && (isNewOwner() || isManagerOfList(request.resource.data.listId));

      allow update: if request.resource.data.ownerId == resource.data.ownerId
        && (isExistingOwner() || isManagerOfList(resource.data.listId));

      allow delete: if isExistingOwner() || isManagerOfList(resource.data.listId);

      match /usageLog/{entryId} {
        allow read: if isExistingOwner()
          || isAcceptedListMember(get(/databases/$(database)/documents/cards/$(cardId)).data.listId);
        allow create: if isNewOwner()
          && request.resource.data.cardId == cardId
          && request.resource.data.amount > 0;
        // Immutable audit trail for direct client access: no client-side edits
        // or deletes. A scoped Server Action (Admin SDK, bypasses these rules)
        // does allow deletion with optional balance restoration — see
        // docs/DECISIONS.md #12. Manager writes also go through that same
        // Server Action path (docs/DECISIONS.md #15), never direct client writes.
        allow update, delete: if false;
      }
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn()
        && (resource.data.ownerId == 'system' || isExistingOwner());
      allow create: if isNewOwner();
      allow update, delete: if isExistingOwner();
    }

    match /reminders/{reminderId} {
      // Reminders are produced by the scheduled Cloud Function (Admin SDK bypasses rules);
      // clients may only read their own.
      allow read: if isExistingOwner();
      allow write: if false;
    }

    match /auditLog/{entryId} {
      // Written only via the Admin SDK (Cloud Functions, or the local MCP
      // server in mcp-server/ — see docs/ROADMAP.md Phase 5.1).
      allow read: if isExistingOwner();
      allow write: if false;
    }

    match /rateLimits/{subjectId} {
      // Internal tool-call and conversation-turn quotas (docs/ROADMAP.md
      // Phase 5.3/5.5.b), read and written only via the Admin SDK. No UI
      // surfaces this doc, so unlike auditLog/reminders there's no owner read
      // either. The id is a uid on every authenticated path, and a channelKey
      // for inbound messages from a number that isn't linked yet.
      allow read, write: if false;
    }

    // --- Messaging channels (docs/ROADMAP.md Phase 5.5, docs/DECISIONS.md
    // ADR #29) ---
    // All three are Admin-SDK-only, in the same `if false` pattern as
    // rateLimits above. The reason is stronger here than "no UI needs it":
    // channelLinks is the *only* thing that maps an inbound phone number to a
    // uid, so a client able to write one could bind its own phone number to
    // someone else's account and then drive that account's data through the
    // bot. The UI reads its own links through a Server Action
    // (src/actions/channelLink.ts), never through the client SDK.

    match /channelLinks/{channelKey} {
      // channelKey == "<channel>:<externalId>", e.g. "whatsapp:+972501234567".
      // Not keyed by uid on purpose: the webhook looks it up by the only thing
      // an inbound message carries, and the doc id must therefore be derivable
      // from that alone.
      allow read, write: if false;
    }

    match /channelLinkCodes/{code} {
      // Short-lived one-time linking codes. Client read would defeat the whole
      // point — the code is the bearer credential that binds a channel to a
      // uid, so knowing someone else's unused code is enough to hijack the
      // link.
      allow read, write: if false;
    }

    match /channelRelinkConfirmations/{channelKey} {
      // Pending "move this number to a different account?" confirmation
      // (issue #75). Internal document written only by the webhook's
      // deterministic layer, same trust class as channelLinks itself — a
      // client that could read or write it could forge or leak a relink
      // confirmation state.
      allow read, write: if false;
    }

    match /chatSessions/{channelKey} {
      // Server-side conversation history for channels that have no client to
      // hold it (the web chat keeps history client-side instead — ADR #22).
      // Contains full message text, i.e. the user's own financial data in
      // free-form prose; never client-readable.
      allow read, write: if false;
    }

    match /channelMessages/{messageId} {
      // Inbound-message dedup claims (Phase 5.5.b). The doc id is the
      // provider's message id, and its *existence* is what makes a Meta retry
      // a no-op — a client able to create one could pre-empt a real inbound
      // message and silence the bot for that message.
      allow read, write: if false;
    }

    match /listInviteCodes/{code} {
      // Phone-number list invitations (docs/DECISIONS.md ADR #39, restoring
      // ADR #37's binding; issue #58).
      // Same bearer-credential class as channelLinkCodes above: the doc id *is*
      // the secret carried in the WhatsApp message, so a client read would let
      // anyone enumerate live invites and accept one meant for someone else.
      // Unlike cardLists/members, this doc cannot be keyed by the invitee's uid
      // — at creation time the owner knows only a phone number, and the uid
      // does not exist yet for a user who has not signed up. Both the owner's
      // and the invitee's views go through Server Actions.
      allow read, write: if false;
    }

    // --- Admin (docs/DECISIONS.md ADR #42) ---
    // Both Admin-SDK-only, same "if false" pattern as rateLimits/auditLog
    // above — even the admin themself never reads these through the client
    // SDK, only through Server Actions/Cloud Functions that already checked
    // isAdminUid() server-side. adminRoles has no UI-facing reason to be
    // client-readable at all (grants happen via scripts/grant-admin.ts), and
    // a client able to write its own doc would be able to self-grant admin.
    match /adminRoles/{uid} {
      allow read, write: if false;
    }

    // Append-only ledger of admin actions taken on users (block/unblock,
    // scheduled/immediate deletion, role grants) — kept separate from the
    // per-user auditLog above so it survives the target account's deletion
    // and supports "all admin activity" queries. Never client-readable, not
    // even by an admin: reads go through an admin Server Action, same as
    // every other admin-only collection here.
    match /adminAuditLog/{entryId} {
      allow read, write: if false;
    }
  }
}
